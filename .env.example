# ImaginAI Rewrite Environment Variables
# Copy this file to .env or export values in your shell.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional local database override. SQLite is the default alpha database.
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=imaginai

# Optional platform/global provider credentials for admin-created global models.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local testing: makes generation return deterministic fake text without provider calls.
IMAGINAI_FAKE_LLM=1
IMAGINAI_ROTATOR_DATA_DIR=backend/.rotator
