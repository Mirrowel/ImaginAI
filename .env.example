# ImaginAI Rewrite Environment Variables
# Copy this file to .env.backend or export values in your shell.
# Django loads .env.backend automatically, but real shell environment values take precedence.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Legacy-compatible frontend origin variable. Used as CSRF fallback when CSRF_TRUSTED_ORIGINS is absent.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Vite reads these from .env.backend for its dev-server /api proxy.
# If port 8000 is occupied, set BACKEND_PORT to the Django runserver port you use.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# BACKEND_ORIGIN=http://127.0.0.1:8000

# PostgreSQL is the primary rewrite database.
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=imaginai
DJANGO_DB_USER=imaginai
DJANGO_DB_PASSWORD=change-me
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
DJANGO_DB_CONN_MAX_AGE=60

# Redis is configured for future cache/background coordination. Current alpha gameplay does not require it.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_URL=redis://127.0.0.1:6379/1

# Optional throwaway local/test fallback if PostgreSQL is intentionally not used.
# DJANGO_DB_ENGINE=django.db.backends.sqlite3
# DJANGO_DB_NAME=backend/db.sqlite3

# Optional platform/global provider credentials for admin-created global models.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local testing: makes generation return deterministic fake text without provider calls.
IMAGINAI_FAKE_LLM=1
IMAGINAI_ROTATOR_DATA_DIR=backend/.rotator
